# Loaded only by `vite build --mode android` (the build:android script),
# exactly the .env.desktop / .env.ios pattern: committed on purpose (a public
# API base and a shell name, not secrets -- .gitignore carries the
# exception), and a real VITE_API_BASE environment variable still wins over
# this file, which is how an emulator build is pointed at a local server.
VITE_API_BASE=https://wherry.app/api
# Update routing (api/shell.ts): a bundled Android build cannot reload its
# way onto a new version; it points at the release page (later, the Play
# Store listing). shell.ts has carried the "android" arm since the iOS
# wrapper landed, so this file is all that was missing.
VITE_SHELL=android
