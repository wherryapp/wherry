# Loaded only by `vite build --mode desktop` (the build:desktop script) --
# the web build never sees this file. It is committed on purpose: this is
# where the desktop bundle points, not a secret, and the .gitignore carries
# an explicit exception for it. A real VITE_API_BASE environment variable
# still wins over this file (Vite's precedence), which is how a test build
# is pointed at a local server.
VITE_API_BASE=https://chat.cjtechsystems.com/api
