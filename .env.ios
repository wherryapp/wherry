# Loaded only by `vite build --mode ios` (the build:ios script), exactly the
# .env.desktop pattern: committed on purpose (a public API base and a shell
# name, not secrets -- .gitignore carries the exception), and a real
# VITE_API_BASE environment variable still wins over this file, which is how
# a simulator build is pointed at a local server.
VITE_API_BASE=https://chat.cjtechsystems.com/api
# Update routing (api/shell.ts): a bundled iOS build cannot reload its way
# onto a new version; it points at the release page (later, the App Store
# listing).
VITE_SHELL=ios
